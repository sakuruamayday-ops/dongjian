{
  "schema_version": 1,
  "product": "洞见专业技能",
  "release": {
    "tag": "V0.1.0",
    "version": "0.1.0",
    "status": "candidate",
    "summary": "洞见内置专业技能，支持项目申报、企业分析和文档交付。",
    "source": {
      "version": "1.6.19",
      "product": "upstream-skill-suite"
    }
  },
  "engine": "skills/evidence-ledger/scripts/grounded_evidence.py",
  "profiles": {
    "chat": {
      "artifacts": [
        "chat"
      ],
      "body_citations": "inline-or-before",
      "source_placement": "selectable",
      "sidecar": false
    },
    "analysis-report": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "end-section",
      "source_title": "数据来源",
      "sidecar": false
    },
    "spreadsheet-native": {
      "artifacts": [
        "xlsx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-worksheet",
      "source_title": "数据来源",
      "sidecar": false
    },
    "presentation-native": {
      "artifacts": [
        "pptx"
      ],
      "body_citations": "numeric-markers",
      "source_placement": "final-slide",
      "source_title": "数据来源",
      "sidecar": false
    },
    "application-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf",
        "xlsx"
      ],
      "body_citations": "native-fields-or-sidecar",
      "source_placement": "template-aware",
      "source_title": "来源说明",
      "sidecar": true
    },
    "standard-native": {
      "artifacts": [
        "md",
        "docx",
        "pdf"
      ],
      "body_citations": "none",
      "source_placement": "separate-source-memo",
      "source_title": "标准数据来源说明",
      "sidecar": true,
      "forbidden_primary_headings": [
        "数据来源",
        "参考资料"
      ],
      "preserve_primary_headings": [
        "规范性引用文件"
      ]
    }
  },
  "artifact_profile_overrides": {
    "xlsx": "spreadsheet-native",
    "pptx": "presentation-native"
  },
  "artifact_validation": {
    "pdf": {
      "required": [
        "reopen",
        "text-extraction",
        "all-pages-render",
        "nonblank-pages",
        "missing-glyph-scan"
      ],
      "font_rule": "embed-cjk-font-or-use-host-native-export",
      "fail_closed": true
    },
    "docx": {
      "required": [
        "reopen",
        "structure-check",
        "host-render-when-available",
        "missing-glyph-scan"
      ],
      "renderer_missing_cjk_is": "pending-device-acceptance",
      "formal_release_requires_host_render": true
    },
    "xlsx": {
      "required": [
        "reopen",
        "sheet-order",
        "formula-check",
        "all-sheets-render"
      ],
      "renderer": "spreadsheet-native",
      "fail_closed": true
    },
    "pptx": {
      "required": [
        "reopen",
        "slide-order",
        "all-slides-render",
        "overflow-check"
      ],
      "fail_closed": true
    }
  },
  "host_adapters": {
    "codex": "_runtime/grounded-citations/codex_adapter.py",
    "first_party_client": "_runtime/grounded-citations/first_party_client_adapter.py"
  },
